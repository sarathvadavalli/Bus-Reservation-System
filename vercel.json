{
  "version": 2,
  "builds": [
    {
      "src": "busreserve/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "staticfiles/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "busreserve/wsgi.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cleanup-seat-inventory/",
      "schedule": "30 20 * * *"
    }
  ]
}